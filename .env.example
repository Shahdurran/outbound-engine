# Leave ANTHROPIC_API_KEY unset to run in REPLAY mode: the six agents replay
# recorded fixtures with their original tool calls and timings, so the console
# is fully explorable with zero setup. Set it to run the agents live.
ANTHROPIC_API_KEY=

# Any current model id. Defaults to claude-opus-5.
# claude-sonnet-5 is the cheaper swap for high-volume runs.
ANTHROPIC_MODEL=claude-opus-5

# Where the SQLite file lives. Railway mounts a volume at /data.
DATABASE_PATH=./data/outbound.db
